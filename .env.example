# --- Obligatorias -----------------------------------------------------------
DATABASE_URL="postgresql://tusuerte:tusuerte@localhost:5432/tusuerte?schema=public"
# Genera uno con: openssl rand -base64 32  (nunca reutilices el de desarrollo en producción)
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# URL pública. En producción debe ser https://… (activa HSTS y la mejora a HTTPS)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Correo (recuperación de contraseña) ------------------------------------
# Sin SMTP_HOST, el enlace se imprime en la consola del servidor (solo desarrollo)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="TuSuerte <no-responder@tu-dominio.ec>"

# --- Datos del organizador (aparecen en pie de página y documentos legales) --
NEXT_PUBLIC_LEGAL_NAME=""
NEXT_PUBLIC_LEGAL_TAX_ID=""
NEXT_PUBLIC_LEGAL_ADDRESS=""
# Pon "true" solo cuando un abogado haya revisado términos, bases y privacidad
NEXT_PUBLIC_LEGAL_REVIEWED="false"

# --- Canales de contacto (se ocultan si están vacíos) -----------------------
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_WHATSAPP=""
NEXT_PUBLIC_CONTACT_INSTAGRAM=""
NEXT_PUBLIC_CONTACT_FACEBOOK=""
NEXT_PUBLIC_CONTACT_HOURS=""

# --- Pruebas ----------------------------------------------------------------
TEST_DATABASE_URL="postgresql://tusuerte:tusuerte@localhost:5432/tusuerte_test?schema=public"
